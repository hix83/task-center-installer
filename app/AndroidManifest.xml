<?xml version="1.0" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="local.taskcenter.launcher" android:versionCode="5" android:versionName="3.1">
  <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="35"/>
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
  <uses-permission android:name="android.permission.INTERNET"/>
  <queries>
    <package android:name="com.miui.securitycenter"/>
  </queries>
  <application android:label="Task Center" android:icon="@drawable/icon" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:allowBackup="false" android:usesCleartextTraffic="false">
    <activity android:name=".MainActivity" android:exported="true" android:excludeFromRecents="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
      <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts"/>
    </activity>
    <receiver android:name=".InstallResultReceiver" android:exported="false"/>
    <provider android:name=".ApkProvider" android:authorities="local.taskcenter.launcher.apk" android:exported="false" android:grantUriPermissions="true"/>
  </application>
</manifest>
